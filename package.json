{
  "name": "wasm-poc",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "all": "npm run build:transform && npm run asbuild && npm run start",
    "asbuild": "asc assembly/module.ts --bindings esm --exportRuntime --exportTable -O3z --outFile build/module.wasm --textFile build/module.wat --transform ./transform/lib/index.js",
    "build:transform": "tsc -p transform",
    "start": "tsx scripts/index.ts",
    "test:transformer": "node scripts/test-transformer.cjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.13.11",
    "assemblyscript": "^0.27.35",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "type": "module",
  "dependencies": {
    "@assemblyscript/loader": "^0.27.35",
    "visitor-as": "^0.11.4"
  }
}
