{
  "name": "wasm-poc",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "asbuild:1": "asc assembly/module1.ts --bindings esm --importMemory --exportRuntime --exportTable -O3z --outFile build/module1.wasm --textFile build/module1.wat",
    "asbuild:2": "asc assembly/module2.ts --bindings esm --importMemory --memoryBase=4096 --exportRuntime --exportTable -O3z --outFile build/module2.wasm --textFile build/module2.wat",
    "asbuild": "npm run asbuild:1 && npm run asbuild:2",
    "start": "tsx scripts/index.ts"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.10.10",
    "assemblyscript": "^0.27.32",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "type": "module",
  "dependencies": {
    "@assemblyscript/loader": "^0.27.35"
  }
}
